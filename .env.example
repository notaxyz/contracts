# RPC endpoint used by the deploy script, for the chain you are deploying to
# (Alchemy, Infura, public node, etc.).
RPC_URL=

# RPC endpoints used only by the forked gas benchmarks in test/GasBenchmarkFork.t.sol.
# Each benchmark suite self-skips when its variable is unset, so `forge test` stays
# green without them. Set one or both to measure against real mainnet USDC:
#   forge test --match-path test/GasBenchmarkFork.t.sol -vv
# Reported lines are prefixed GASBENCH| and are differenced across the .zeroFee
# suites to price the protocol-fee leg.
BASE_RPC_URL=
ARBITRUM_RPC_URL=

# Deployer key. Also becomes the protocol owner / admin if PROTOCOL_OWNER is unset.
# Post-deploy this key controls pause states, registry consumer authorization, and
# can transfer ownership later (e.g. to a hardware wallet or Safe). Store it
# encrypted (Foundry keystore, password manager) and back it up off-machine.
PRIVATE_KEY=

# Settlement token (ERC-20). Must use 6 decimals. The deploy script enforces this.
# Base mainnet (chainid 8453): must be Circle's native USDC, pinned in script:
#   0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
#   Bridged USDbC (0xd9AAEc86B65D86f6A7B5B1b0c42FFA531710b6CA) is rejected.
# Arbitrum One mainnet (chainid 42161): must be Circle's native USDC, pinned in script:
#   0xaf88d065e77c8cC2239327C5EDb3A432268e5831
# Testnets (e.g. Arbitrum Sepolia, chainid 421614): any 6-decimal test USDC.
SETTLEMENT_TOKEN=

# Address that receives protocol fees in settlement-token base units. Immutable
# after deploy — pick carefully and verify it can receive USDC. Required when
# PROTOCOL_FEE_BPS > 0. May be the zero address only when PROTOCOL_FEE_BPS = 0.
# On Base mainnet it MUST be left empty: the deploy script refuses a fee recipient
# at zero fee, so the deployed contract carries no fee destination at all.
FEE_RECIPIENT=

# Protocol fee in basis points. Must equal the fee the deploy script expects for the
# chain you are deploying to, which the script enforces:
#   Base mainnet (chainid 8453): 0. The receipt path is free, and immutable at zero --
#     neither PROTOCOL_FEE_BPS nor FEE_RECIPIENT has a setter, so it cannot be turned
#     on after integrators have embedded it. A fee, if ever, belongs on the
#     reconciliation API rather than on settlement.
#   Every other chain: EXPECTED_PROTOCOL_FEE_BPS in Deploy.s.sol (currently 50 = 0.5%).
# Defaulted to the Base value. Update the script constant and this value together.
PROTOCOL_FEE_BPS=0

# Optional. Protocol owner address.
# - If unset OR equal to the deployer: the deploy script skips transferOwnership and
#   the deployer becomes the immediate owner of both contracts. No Ownable2Step
#   pending-owner window. This is the recommended path for solo deploys.
# - If set to a different address: the registry ownership is *queued* to that
#   address and the script does NOT call acceptOwnership(); the target address
#   must call acceptOwnership() in a separate transaction before it actually
#   owns the registry. The receipt store owner is set directly in its constructor.
PROTOCOL_OWNER=
