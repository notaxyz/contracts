# Arbitrum One RPC endpoint (Alchemy, Infura, public node, etc.)
RPC_URL=

# Deployer key. Also becomes the protocol owner / admin if PROTOCOL_OWNER is unset.
# Post-deploy this key controls pause states, registry consumer authorization, and
# can transfer ownership later (e.g. to a hardware wallet or Safe). Store it
# encrypted (Foundry keystore, password manager) and back it up off-machine.
PRIVATE_KEY=

# Settlement token (ERC-20). Must use 6 decimals. The deploy script enforces this.
# Arbitrum One mainnet (chainid 42161): must be Circle's native USDC, pinned in script:
#   0xaf88d065e77c8cC2239327C5EDb3A432268e5831
# Arbitrum Sepolia (chainid 421614): any 6-decimal test USDC.
SETTLEMENT_TOKEN=

# Address that receives protocol fees in settlement-token base units. Immutable
# after deploy — pick carefully and verify it can receive USDC. Required when
# PROTOCOL_FEE_BPS > 0. May be the zero address only when PROTOCOL_FEE_BPS = 0.
FEE_RECIPIENT=

# Protocol fee in basis points. Must equal EXPECTED_PROTOCOL_FEE_BPS in Deploy.s.sol
# (currently 50 = 0.5%). Update both deliberately if changing.
PROTOCOL_FEE_BPS=50

# Optional. Protocol owner address.
# - If unset OR equal to the deployer: the deploy script skips transferOwnership and
#   the deployer becomes the immediate owner of both contracts. No Ownable2Step
#   pending-owner window. This is the recommended path for solo deploys.
# - If set to a different address: the registry ownership is *queued* to that
#   address and the script does NOT call acceptOwnership(); the target address
#   must call acceptOwnership() in a separate transaction before it actually
#   owns the registry. The receipt store owner is set directly in its constructor.
PROTOCOL_OWNER=
